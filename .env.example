# =============================================================================
# TEMPLATE ENVIRONMENT - SALINAN INI BOLEH MASUK KE REPOSITORY.
# Isi nilai nyatanya di tempat lain - TIDAK pernah di sini.
#
# PENTING: `.env.keys`, `.env`, `.env.local`, dan semua turunannya WAJIB tetap
# diabaikan Git. Tapi `.gitignore` HANYA berlaku pada berkas yang belum
# terlacak. Begitu sebuah berkas masuk `index`, aturannya mati - itu sebabnya
# `.env.keys` pernah ikut terpublikasi dan harus dihapus dengan
# `git rm --cached`, bukan hanya dengan aturan .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Convex - wajib
# -----------------------------------------------------------------------------

# Convex deployment URL - ganti dengan URL deployment Anda.
# Jalankan 'npx convex dev' untuk mendapat URL pengembangan.
VITE_CONVEX_URL=

# Convex site URL untuk auth.
CONVEX_SITE_URL=http://localhost:5173

# Deployment yang dipakai `npx convex dev`.
CONVEX_DEPLOYMENT=

# Issuer token federated Freebuff, dipakai src/convex/auth.config.ts.
#
# WAJIB DIISI, dan ini bukan sekadar formalitas: Convex mensyaratkan variabel
# auth-config benar-benar ada di backend. Operator `?? "https://freebuff.com"`
# di dalam kode tetap dianggap KOSONG oleh analyzer, sehingga `convex dev --once`
# berhenti sebelum selesai, `src/convex/_generated/` tidak pernah terbentuk, dan
# setiap test yang menyentuh API Convex gagal saat import tanpa error yang
# menunjuk ke penyebabnya.
VLY_CONVEX_AUTH_ISSUER=https://freebuff.com

# -----------------------------------------------------------------------------
# Kunci enkripsi nomor telepon warga (Fase 16-17) - WAJIB di produksi
# -----------------------------------------------------------------------------

# Master key untuk AES-GCM-256 + HKDF. Isi DENGAN 32 byte base64.
# Buat dengan: openssl rand -base64 32
#
# Perilaku kalau kosong: SETIAP mutasi yang menyentuh nomor warga melempar.
# Itu disengaja - kegagalan diam-diam di sini berarti database tetap polos
# sementara aplikasi terlihat normal, dan itu jauh lebih buruk daripada error
# yang jelas.
#
# JANGAN pernah mengganti nilainya setelah data terenkripsi sudah ada. Kunci ini
# bukan sandi login. Mengganti kunci membuat seluruh ciphertext lama tidak
# terbaca, dan nomor warga yang sudah ada tidak punya salinan polos untuk
# dipulihkan setelah kolom polos dikosongkan. Kalau kunci hilang, pemulihan
# hanya mungkin lewat backup - bukan lewat kode.
PHONE_DATA_KEY=

# -----------------------------------------------------------------------------
# Route konteks admin / CORS (Fase 10)
# -----------------------------------------------------------------------------

# Daftar origin yang BOLEH membaca route POST /admin-gate/context.
# Dipisah koma. Untuk produksi:
#   ADMIN_CONTEXT_ALLOWED_ORIGINS=https://sumenepbukukerja.freebuff.app
#
# Kalau kosong: route menutup lintas origin, dan panel "Sesi Anda" menampilkan
# "Tidak terdeteksi" untuk IP. Ini fail-closed - kosong berarti TUTUP, bukan
# terbuka.
#
# JANGAN memakai SITE_URL di sini. Pada deployment yang diuji, SITE_URL menunjuk
# origin `.convex.site` itu sendiri, bukan origin frontend.
ADMIN_CONTEXT_ALLOWED_ORIGINS=

# Set true HANYA di pengembangan, hanya saat benar-benar perlu menguji origin
# arbitrer. Di produksi biarkan kosong: wildcard membuat route konteks dapat
# dibaca situs mana pun.
ADMIN_CONTEXT_ALLOW_WILDCARD_CORS=

# -----------------------------------------------------------------------------
# Relay admin bertanda tangan (Fase 9.2-9.3)
# -----------------------------------------------------------------------------

# Dua kunci, tugasnya BERBEDA, dan nilainya memang harus berbeda.

# ADMIN_CONTEXT_RELAY_SECRET membuktikan identitas pengirim relay. Ada di dua
# tempat (Vercel dan Convex) dan melewati jaringan, jadi nilainya harus sama
# persis di keduanya.
#
# SERVER_IP_HASH_SECRET menjaga hash IP tidak bisa ditebak dari daftar alamat
# yang masuk akal. WAJIB di produksi: kalau kosong, `ipHash` sengaja tidak
# dibuat dan Security Desk mencatat `missing-in-production`. Di luar produksi
# secret relay boleh dipakai sebagai cadangan, ditandai
# `hmac-sha256-fallback`.
#
# Jangan menyamakan keduanya. Kalau satu kunci dipakai untuk dua tugas,
# kebocoran di satu tempat langsung membuka yang lain, dan tidak ada cara
# mengetahui kunci mana yang bocor karena keduanya menghasilkan HMAC yang
# sama bentuknya.
#
# Buat dengan: openssl rand -base64 32
#
# Perilaku kalau relay secret kosong: relay MATI, bukan terbuka tanpa
# password. Security Desk mencatat `telemetryStatus: failed`.
ADMIN_CONTEXT_RELAY_SECRET=

SERVER_IP_HASH_SECRET=

# -----------------------------------------------------------------------------
# WhatsApp Cloud API
# -----------------------------------------------------------------------------

# App secret dari Meta. WAJIB rotate (lihat docs/security/HARDENING-STATUS-ANALYSIS.md
# bagian 2): repo ini pernah publik, jadi semua nilai yang pernah berada di
# dalam `.env.keys` harus dianggap bocor sampai dibuktikan sebaliknya.
# Secret ini adalah yang memverifikasi tanda tangan webhook - jika bocor,
# penyerang bisa menandatangani ulang payload webhook palsu.
WHATSAPP_APP_SECRET=
