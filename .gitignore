# Dependensi dan hasil build
node_modules
dist

# CATATAN: `src/convex/_generated` SENGAJA TIDAK diabaikan Git.
# Folder itu hasil codegen Convex, tapi build di Vercel berjalan tanpa
# kredensial Convex - `convex codegen` di sana gagal dengan
# `401 MissingAccessToken`. Jadi folder ini ikut ter-commit, sesuai anjuran
# resmi Convex di `convex codegen --help`.
# Regenerasi: `npx convex codegen`. Penjaga: scripts/qa/ensure-convex-codegen.mjs

# Screenshot QA sementara (Phase 3), bukan aset repo
tmp/

# Artefak Playwright. Setiap `bun run test:e2e` yang gagal menulis screenshot,
# video, dan trace ke sini - semuanya biner dan besar. `test-results/.last-run.json`
# pernah ikut terlacak, jadi satu kali menjalankan e2e langsung menghasilkan
# diff berisi binary yang tidak berguna di histori.
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ---------------------------------------------------------------------------
# RAHASIA - FASE 0
# ---------------------------------------------------------------------------
# `.env.keys` memuat kunci PRIVAT Dotenvx. Kunci itu bisa mendekripsi seluruh
# `.env.production` yang terenkripsi, jadi satu salinan yang lolos ke Git
# setara dengan membocorkan semua nilai di dalamnya sekaligus.
#
# Sebelumnya berkas ini TIDAK ada di daftar ini, sehingga satu `git add -A`
# sudah cukup untuk membuat kunci itu ikut ter-commit. Aturan di bawah menutup
# seluruh keluarga nama yang dipakai alat (dotenv, dotenvx, Vercel, Convex,
# Firebase, Playwright) dan sekaligus semua bentuk dump yang sering dipakai
# saat menyalin nilai rahasia.
.env
.env.*
!.env.example

# Kunci privat Dotenvx, dalam semua nama turunannya.
.env.keys
.env.keys.*
*.env.keys

# Cadangan dan salinan bernomor dari berkas environment.
.env.bak
.env.backup
.env.old
.env.*.bak
.env.*.backup
.env.*.old
.env.*.tmp
.env.*.local

# Dump yang dibuat manusia saat menyalin rahasia keluar dari deployment.
# Nama-nama ini tidak pernah dihasilkan build, jadi kalau muncul di `git
# status` artinya ada yang salah.
*.secrets
*.secrets.*
secrets.json
secrets.*.json
env.dump
env-dump.txt
.env.dump
deploy-prod.env
*.pem
*.key
*.p12
*.pfx

# Konfigurasi lokal alat, bukan bagian aplikasi.
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.local
.vercel
.superpowers/
